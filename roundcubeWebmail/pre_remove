#!/bin/bash
# Roundcube Webmail: catalog uninstall is a no-op (host package owns files).
set -euo pipefail
LOG="/var/log/cpn/roundcubeWebmail_pre_remove.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "[$(date -Iseconds)] roundcubeWebmail pre_remove: host package files under /opt/cpn-webmail/roundcube are left in place. Uninstall via Plugins > Host packages or: cpn app uninstall --name roundcube"
exit 0
