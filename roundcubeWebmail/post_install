#!/bin/bash
# Roundcube Webmail catalog entry: redirect to CPN host package install.
# Legacy CyberPanel paths are intentionally not used.
set -euo pipefail

LOG="/var/log/cpn/roundcubeWebmail_post_install.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "[$(date -Iseconds)] roundcubeWebmail post_install: host-package redirect"

if command -v cpn >/dev/null 2>&1; then
  if cpn app install --name roundcube; then
    echo "Installed Roundcube via host package (cpn app install --name roundcube)."
    exit 0
  fi
  echo "WARNING: cpn app install --name roundcube failed; open Plugins > Host packages (Email)."
  exit 1
fi

echo "ERROR: Roundcube is a CPN Email host package. Install from Plugins > Host packages (Email), or install a CPN panel build that provides: cpn app install --name roundcube"
exit 1
