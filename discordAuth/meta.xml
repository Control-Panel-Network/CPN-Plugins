<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <name>Discord Authentication</name>
    <type>Security</type>
    <version>1.0.1</version>
    <description>Enable Discord OAuth2 authentication for CPN Panel. Users can log in to CPN Panel using their Discord account. Supports account linking and automatic user creation.</description>
    <author>master3395</author>
    <website>https://github.com/master3395/CPN-plugins</website>
    <license>MIT</license>
    <dependencies>
        <python>3.6+</python>
        <django>2.2+</django>
        <CPN>2.5.5+</CPN>
    </dependencies>
    <compatibility>
        <min_version>2.5.5</min_version>
        <max_version>3.0.0</max_version>
    </compatibility>
    <permissions>
        <admin>true</admin>
        <user>false</user>
    </permissions>
    <url>/plugins/discordAuth/</url>
    <settings_url>/plugins/discordAuth/settings/</settings_url>
    <released>2024-07-01</released>
    <updated>2026-04-01</updated>
    <install_count>36</install_count>
    <featured>false</featured>
</plugin>
