#!/bin/bash
# SnappyMail Webmail plugin pre-remove: stop serving, preserve data.
set -euo pipefail

PLUGIN_HOME="/usr/local/cpn/snappymailWebmail"
LOG="/var/log/cpn/snappymailWebmail_pre_remove.log"
mkdir -p "$(dirname "$LOG")"

exec >>"$LOG" 2>&1
echo "[$(date -Iseconds)] snappymailWebmail pre_remove start"

if [ -d "$PLUGIN_HOME" ]; then
  /usr/local/cpn/bin/python - <<'PY'
import sys
sys.path.insert(0, '/usr/local/cpn')
from snappymailWebmail import utils
ok, message = utils.pre_remove_tasks()
print(message)
sys.exit(0 if ok else 1)
PY
fi

if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet lsws 2>/dev/null; then
  systemctl restart lsws || true
fi

echo "[$(date -Iseconds)] snappymailWebmail pre_remove done"
